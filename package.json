{
  "name": "dsh-qqbot-guard",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：QQ 机器人（OneBot / NapCat / LLOneBot）假死自愈守卫。深度健康检查（进程活着但网关断了断）→ 自动重启 → 防抖 + 冷却防误杀。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qqbot",
    "onebot",
    "napcat",
    "llonebot",
    "self-healing",
    "watchdog",
    "guard"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}